<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Havi — Hey Banco</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --brand: #6c2fff;
    --brand-dark: #4a1fbf;
    --accent: #00e5b0;
    --bg: #0d0d14;
    --surface: #16161f;
    --surface2: #1e1e2e;
    --border: rgba(255,255,255,0.07);
    --text: #f0f0f8;
    --muted: #7a7a9a;
    --user-bubble: linear-gradient(135deg, #6c2fff, #a855f7);
    --bot-bubble: #1e1e2e;
    --radius: 20px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
  }

  /* Fondo animado */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 40% at 20% 10%, rgba(108,47,255,0.18) 0%, transparent 60%),
      radial-gradient(ellipse 50% 30% at 80% 90%, rgba(0,229,176,0.10) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .app {
    width: 100%;
    max-width: 680px;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  /* ===== HEADER ===== */
  header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(13,13,20,0.85);
    backdrop-filter: blur(20px);
    flex-shrink: 0;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: var(--user-bubble);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
    box-shadow: 0 0 20px rgba(108,47,255,0.4);
  }

  .header-info h1 {
    font-family: 'Syne', sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .header-info p {
    font-size: 12px;
    color: var(--muted);
    margin-top: 1px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    margin-left: auto;
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Badge usuario identificado */
  #user-badge {
    display: none;
    margin: 0 24px;
    padding: 8px 14px;
    background: rgba(0,229,176,0.1);
    border: 1px solid rgba(0,229,176,0.25);
    border-radius: 10px;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    flex-shrink: 0;
  }

  #user-badge.visible {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
  }

  #user-badge span { opacity: 0.6; }

  /* ===== CHAT AREA ===== */
  #chat {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    scroll-behavior: smooth;
  }

  #chat::-webkit-scrollbar { width: 4px; }
  #chat::-webkit-scrollbar-track { background: transparent; }
  #chat::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

  .msg {
    display: flex;
    animation: msgIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(12px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .msg.user { justify-content: flex-end; }
  .msg.bot  { justify-content: flex-start; }

  .bubble {
    max-width: 72%;
    padding: 12px 16px;
    border-radius: var(--radius);
    font-size: 14px;
    line-height: 1.55;
    word-wrap: break-word;
  }

  .msg.user .bubble {
    background: var(--user-bubble);
    color: white;
    border-bottom-right-radius: 5px;
    box-shadow: 0 4px 20px rgba(108,47,255,0.3);
  }

  .msg.bot .bubble {
    background: var(--bot-bubble);
    color: var(--text);
    border-bottom-left-radius: 5px;
    border: 1px solid var(--border);
  }

  /* Cursor parpadeante al escribir */
  .typing-cursor::after {
    content: '▋';
    animation: blink 0.7s infinite;
    color: var(--accent);
    font-size: 12px;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Puntos de "escribiendo..." */
  .dots span {
    display: inline-block;
    width: 6px; height: 6px;
    background: var(--muted);
    border-radius: 50%;
    margin: 0 2px;
    animation: dot 1.2s infinite;
  }
  .dots span:nth-child(2) { animation-delay: 0.2s; }
  .dots span:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dot {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.4; }
    40% { transform: scale(1.1); opacity: 1; }
  }

  /* ===== INPUT ===== */
  .input-wrap {
    padding: 14px 24px 20px;
    border-top: 1px solid var(--border);
    background: rgba(13,13,20,0.9);
    backdrop-filter: blur(20px);
    flex-shrink: 0;
  }

  .input-row {
    display: flex;
    gap: 10px;
    align-items: flex-end;
  }

  #msg-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 13px 16px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    resize: none;
    outline: none;
    transition: border-color 0.2s;
    max-height: 120px;
    line-height: 1.4;
  }

  #msg-input::placeholder { color: var(--muted); }
  #msg-input:focus { border-color: var(--brand); }

  #send-btn {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: var(--user-bubble);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 4px 14px rgba(108,47,255,0.4);
  }

  #send-btn:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(108,47,255,0.5); }
  #send-btn:active { transform: scale(0.97); }
  #send-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }

  #send-btn svg { width: 18px; height: 18px; fill: white; }

  .hint {
    font-size: 11px;
    color: var(--muted);
    margin-top: 8px;
    text-align: center;
  }
</style>
</head>
<body>
<div class="app">

  <!-- HEADER -->
  <header>
    <div class="avatar">💳</div>
    <div class="header-info">
      <h1>Havi</h1>
      <p>Asistente de Hey Banco</p>
    </div>
    <div class="status-dot" id="status-dot"></div>
  </header>

  <!-- BADGE USUARIO -->
  <div id="user-badge">
    <span>✓</span>
    <strong id="badge-name">—</strong>
    <span id="badge-cluster"></span>
  </div>

  <!-- CHAT -->
  <div id="chat"></div>

  <!-- INPUT -->
  <div class="input-wrap">
    <div class="input-row">
      <textarea
        id="msg-input"
        rows="1"
        placeholder="Escribe tu mensaje o ingresa USR-XXXXX..."
      ></textarea>
      <button id="send-btn" onclick="sendMessage()">
        <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="hint">Enter para enviar · Shift+Enter para nueva línea</div>
  </div>

</div>

<script>
  const BACKEND = "http://localhost:8000";

  const chatEl    = document.getElementById("chat");
  const inputEl   = document.getElementById("msg-input");
  const sendBtn   = document.getElementById("send-btn");
  const badge     = document.getElementById("user-badge");
  const badgeName = document.getElementById("badge-name");
  const badgeCluster = document.getElementById("badge-cluster");

  let userId   = null;
  let history  = [];  // [{role, content}]

  // ===== INICIAR =====
  window.onload = () => {
    addBotMsg("¡Hola! Soy Havi 👋\nIngresa tu ID de usuario (USR-XXXXX) para que pueda personalizarte la experiencia.");
    checkBackend();
  };

  async function checkBackend() {
    try {
      const r = await fetch(`${BACKEND}/`);
      if (!r.ok) throw new Error();
    } catch {
      addBotMsg("⚠️ No puedo conectar con el servidor. Asegúrate de que el backend esté corriendo.");
      document.getElementById("status-dot").style.background = "#ef4444";
    }
  }

  // ===== ENTER para enviar =====
  inputEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      sendMessage();
    }
  });

  // Auto-resize textarea
  inputEl.addEventListener("input", () => {
    inputEl.style.height = "auto";
    inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + "px";
  });

  // ===== ENVIAR MENSAJE =====
  async function sendMessage() {
    const text = inputEl.value.trim();
    if (!text) return;

    inputEl.value = "";
    inputEl.style.height = "auto";
    sendBtn.disabled = true;

    addUserMsg(text);

    // ¿Es un user_id?
    if (/^USR-\d{5}$/i.test(text)) {
      await identifyUser(text.toUpperCase());
    } else {
      await askBot(text);
    }

    sendBtn.disabled = false;
    inputEl.focus();
  }

  // ===== IDENTIFICAR USUARIO =====
  async function identifyUser(uid) {
    const typing = addTyping();
    try {
      // Perfil
      const pr = await fetch(`${BACKEND}/users/${uid}/profile`);
      if (!pr.ok) {
        removeTyping(typing);
        addBotMsg(`No encontré el usuario ${uid}. Verifica el ID e intenta de nuevo.`);
        return;
      }
      const profile = await pr.json();
      userId = uid;

      // Cluster
      let clusterName = "";
      try {
        const cr = await fetch(`${BACKEND}/users/${uid}/cluster`);
        if (cr.ok) {
          const cd = await cr.json();
          clusterName = cd?.info?.name || "";
        }
      } catch {}

      // Badge
      badgeName.textContent = `${profile.ocupacion || "Usuario"} · ${profile.edad || "?"} años`;
      badgeCluster.textContent = clusterName ? `· ${clusterName}` : "";
      badge.classList.add("visible");

      removeTyping(typing);
      const bienvenida = `¡Te identifiqué! 💜\nEstoy listo para ayudarte con tu cuenta Hey Banco. ¿En qué te puedo apoyar hoy?`;
      addBotMsg(bienvenida);
      history = [];

    } catch (err) {
      removeTyping(typing);
      addBotMsg(`Error conectando al servidor: ${err.message}`);
    }
  }

  // ===== CHAT CON BOT =====
  async function askBot(message) {
    // Agregar al historial antes de enviar
    history.push({ role: "user", content: message });

    const typing = addTyping();

    try {
      const res = await fetch(`${BACKEND}/chat`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: message,
          user_id: userId,
          conversation_history: history.slice(0, -1)  // sin el último (ya va en message)
        })
      });

      if (!res.ok) throw new Error(`Error ${res.status}`);
      const data = await res.json();
      const reply = data.response || "Sin respuesta";

      removeTyping(typing);
      // Efecto de escritura real sin refresh
      await typeMessage(reply);

      // Guardar en historial
      history.push({ role: "assistant", content: reply });

    } catch (err) {
      removeTyping(typing);
      addBotMsg(`❌ Error: ${err.message}`);
      history.pop(); // quitar el mensaje fallido
    }
  }

  // ===== EFECTO DE ESCRITURA (sin refresh) =====
  async function typeMessage(text) {
    const div = document.createElement("div");
    div.className = "msg bot";
    const bubble = document.createElement("div");
    bubble.className = "bubble typing-cursor";
    bubble.textContent = "";
    div.appendChild(bubble);
    chatEl.appendChild(div);
    scrollDown();

    for (const char of text) {
      bubble.textContent += char;
      scrollDown();
      await sleep(12);
    }
    bubble.classList.remove("typing-cursor");
  }

  // ===== HELPERS =====
  function addUserMsg(text) {
    const div = document.createElement("div");
    div.className = "msg user";
    div.innerHTML = `<div class="bubble">${escHtml(text)}</div>`;
    chatEl.appendChild(div);
    scrollDown();
  }

  function addBotMsg(text) {
    const div = document.createElement("div");
    div.className = "msg bot";
    div.innerHTML = `<div class="bubble">${escHtml(text)}</div>`;
    chatEl.appendChild(div);
    scrollDown();
    return div;
  }

  function addTyping() {
    const div = document.createElement("div");
    div.className = "msg bot";
    div.innerHTML = `<div class="bubble"><div class="dots"><span></span><span></span><span></span></div></div>`;
    chatEl.appendChild(div);
    scrollDown();
    return div;
  }

  function removeTyping(el) { el?.remove(); }

  function scrollDown() {
    chatEl.scrollTop = chatEl.scrollHeight;
  }

  function escHtml(str) {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\n/g, "<br>");
  }

  function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
</script>
</body>
</html>